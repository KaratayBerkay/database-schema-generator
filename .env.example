# ─────────────────────────────────────────────────────────────
# Schema Studio — Environment Variables
# Copy this file to .env and fill in the values.
# None of these are required to run the app locally.
# They are only needed when using the Migrations workflow
# to connect to a live database.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Used by: Migrations → Collect, Validate, Run
# Example: postgresql://user:password@localhost:5432/mydb
POSTGRES_URL=

# MySQL connection string
# Used by: Migrations → Collect, Validate, Run
# Example: mysql://user:password@localhost:3306/mydb
MYSQL_URL=

# Credential-encryption master key (64 hex chars) for stored DB connections.
# Optional. If unset, a per-environment key is auto-generated, which means a
# connection saved in Docker won't decrypt under local `pnpm dev` and vice
# versa. Set the SAME value here and in Docker (docker-compose.yaml reads this
# .env) to make saved connections portable between the two.
# Generate one with:  openssl rand -hex 32
CONNECTION_ENCRYPTION_KEY=
